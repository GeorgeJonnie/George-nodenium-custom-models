                "model": {
                    "type": "model",
                    "model": "item/custom/model/cyberpunk_sword"
                }
            },
            {
                "threshold": 5,
                "model": {
                    "type": "model",
                    "model": "item/custom/model/cyberpunk_katana"
                }
            }
