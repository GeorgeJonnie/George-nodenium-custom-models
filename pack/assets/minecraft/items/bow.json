{
    "model": {
      "type": "range_dispatch",
      "property": "custom_model_data",
      "fallback": {
          "type": "model",
          "model": "item/crossbow"
      },
        "entries": [
            {
                "threshold": 0,
                "model": {
                    "type": "minecraft:condition",
                    "on_false": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/bow"
                    },
                    "on_true": {
                      "type": "minecraft:range_dispatch",
                      "entries": [
                        {
                          "model": {
                            "type": "minecraft:model",
                            "model": "minecraft:item/bow_pulling_1"
                          },
                          "threshold": 0.65
                        },
                        {
                          "model": {
                            "type": "minecraft:model",
                            "model": "minecraft:item/bow_pulling_2"
                          },
                          "threshold": 0.9
                        }
                      ],
                      "fallback": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/bow_pulling_0"
                      },
                      "property": "minecraft:use_duration",
                      "scale": 0.05
                    },
                    "property": "minecraft:using_item"
                  }
            },
            {
                "threshold": 1,
                "model": {
                    "type": "minecraft:condition",
                    "property": "minecraft:using_item",
                    "on_false": {
                        "type": "minecraft:model",
                        "model": "item/custom/model/portal_gun"
                    },
                    "on_true": {
                        "type": "minecraft:range_dispatch",
                        "property": "minecraft:use_duration",
                        "scale": 0.05,
                        "fallback": {
                            "type": "minecraft:model",
                            "model": "item/custom/model/portal_gun"
                        },
                        "entries": []
                    }
                }
            },
            {
                "threshold": 2,
                "model": {
                    "type": "minecraft:condition",
                    "on_false": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/custom/model/cupid_bow"
                    },
                    "on_true": {
                      "type": "minecraft:range_dispatch",
                      "entries": [
                        {
                          "model": {
                            "type": "minecraft:model",
                            "model": "minecraft:item/custom/model/cupid_bow_pulling_1"
                          },
                          "threshold": 0.65
                        },
                        {
                          "model": {
                            "type": "minecraft:model",
                            "model": "minecraft:item/custom/model/cupid_bow_pulling_2"
                          },
                          "threshold": 0.9
                        }
                      ],
                      "fallback": {
                        "type": "minecraft:model",
                        "model": "minecraft:item/custom/model/cupid_bow_pulling_0"
                      },
                      "property": "minecraft:use_duration",
                      "scale": 0.05
                    },
                    "property": "minecraft:using_item"
                  }
                }
        ]
    }
}