                    "model": "item/custom/model/star_guitar"
                }
            },
            {
                "threshold": 3,
                "model": {
                    "type": "model",
                    "model": "item/custom/dungeons_diamond_axe"
                }
            },
            {
                "threshold": 4,
                "model": {
                    "type": "model",
                    "model": "item/custom/model/chainsaw"
                }
            },
            {
                "threshold": 5,
                "model": {
                    "type": "model",
                    "model": "item/custom/model/cyberpunk_axe"
                }
            }
        ]
    }
