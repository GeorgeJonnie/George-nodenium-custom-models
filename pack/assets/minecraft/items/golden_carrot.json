{
    "model": {
        "type": "range_dispatch",
        "property": "custom_model_data",
        "fallback": {
            "type": "model",
            "model": "item/golden_carrot"
        },
        "entries": [
            {
                "threshold": 1,
                "model": {
                    "type": "model",
                    "model": "item/custom/nodenium_cookie"
                }
            },
            {
                "threshold": 2,
                "model": {
                    "type": "model",
                    "model": "item/custom/tomato"
                }
            },
            {
                "threshold": 3,
                "model": {
                    "type": "model",
                    "model": "item/custom/candy_cane"
                }
            },
            {
                "threshold": 4,
                "model": {
                    "type": "model",
                    "model": "item/custom/christmas_pudding"
                }
            },
            {
                "threshold": 5,
                "model": {
                    "type": "model",
                    "model": "item/custom/gingerbread_cookie"
                }
            },
            {
                "threshold": 6,
                "model": {
                    "type": "model",
                    "model": "item/custom/cooked_turkey"
                }
            },
            {
                "threshold": 7,
                "model": {
                    "type": "model",
                    "model": "item/custom/model/dragonfruit"
                }
            }
        ]
    }
}